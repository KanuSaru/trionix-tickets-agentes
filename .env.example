# Copia este archivo como .env y reemplaza los valores. El .env NUNCA se sube al repositorio.

# Local (MongoDB instalado en tu equipo):
MONGODB_URI=mongodb://127.0.0.1:27017/trionix
# Producción / Atlas (usuario, contraseña y cluster reales; incluye el nombre de la base "/trionix"):
# MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@cluster0.xxxxx.mongodb.net/trionix?retryWrites=true&w=majority

# Puerto (opcional; Render/Railway lo asignan automáticamente)
PORT=3000
